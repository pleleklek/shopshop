# URL ของเว็บจริง (ใช้ทำ sitemap / SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=ShopShop

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role ใช้ฝั่ง server เท่านั้น ห้ามใส่ NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# หลังบ้าน /admin (Basic Auth)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Vercel Cron จะส่ง Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# YouTube Data API v3 (Google Cloud Console)
YOUTUBE_API_KEY=

# Shopee Affiliate Open API (affiliate.shopee.co.th -> Open API)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_AFFILIATE_ENDPOINT=https://open-api.affiliate.shopee.co.th/graphql
